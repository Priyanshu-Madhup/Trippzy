{
  "expo": {
    "name": "Trippzy",
    "slug": "trippzy",
    "scheme": "trippzy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.trippzy.app",
      "adaptiveIcon": {
        "backgroundColor": "#111110",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F7F7F5",
          "dark": {
            "backgroundColor": "#0B0B0C"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Trippzy uses the camera so you can photograph a ticket or booking confirmation.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "application/pdf",
            "image/*"
          ],
          "androidMultiIntentFilters": [
            "application/pdf",
            "image/*"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trippzy uses your location while the app is open to work out how far you are from your airport or station and when you should leave.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Trippzy adds your flights, trains and hotel stays to a Trippzy calendar so your phone can remind you before they start."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ad0cccb9-2ef4-49ec-a0a4-2724ae7148e2"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "owner": "priyanshu_madhup2005"
  }
}
