# Public values only — everything here ships inside the app. No secrets.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Where the app finds the API:
#   Android emulator on this PC  -> http://10.0.2.2:8000
#   Physical phone on your Wi-Fi -> http://<this PC's Wi-Fi IPv4>:8000   (find it with `ipconfig`)
#   Deployed                     -> https://your-api.up.railway.app
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Show "Continue with Apple" (enable the Apple provider in Clerk first). Default: hidden.
EXPO_PUBLIC_ENABLE_APPLE=false
