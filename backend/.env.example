# ─── Copy to .env (never commit .env) ──────────────────────────────
ENV=dev
LOG_LEVEL=INFO

# MongoDB Atlas — use a least-privilege user (readWrite on one database), NOT Atlas Admin.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGODB_DB=trippzy

# Clerk — issuer is your Frontend API URL (Dashboard → API keys), e.g. https://xxxx.clerk.accounts.dev
CLERK_ISSUER=
# Alternative to CLERK_ISSUER: the issuer is derived from the (public) publishable key.
CLERK_PUBLISHABLE_KEY=
# Optional until you need Delete account / first-login name+email.
CLERK_SECRET_KEY=
# Comma-separated origins allowed in the token's `azp` claim (checked only when present)
CLERK_AUTHORIZED_PARTIES=

# Cloudflare R2 (S3 API). Endpoint is account-level: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=trippzy

# OpenRouter — restrict this key and set a spend limit in the OpenRouter dashboard.
OPENROUTER_API_KEY=
# Verify the exact slug on OpenRouter (and that it supports images + structured outputs).
OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_FALLBACK_MODEL=
# Leave empty to use OPENROUTER_MODEL for images too.
OPENROUTER_VISION_MODEL=

# Optional imagery / logos
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
GOOGLE_PLACES_API_KEY=
LOGO_DEV_TOKEN=

# Run the job worker inside the API process (fine for one instance). Set false when
# running a separate worker service: `python -m app.worker`
RUN_WORKER_IN_API=true
TOMTOM_API_KEY=

# App updates (GitHub Releases). GITHUB_REPO is "owner/name". GITHUB_TOKEN (read-only, contents) only if the repo is private.
GITHUB_REPO=
GITHUB_TOKEN=
# This API's public https URL on Railway, e.g. https://trippzy-api.up.railway.app
PUBLIC_BASE_URL=
